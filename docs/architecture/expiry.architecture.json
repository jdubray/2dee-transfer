  "cards": [
    {
      "dot": "cyan",
      "title": "The short answer",
      "items": [
        "The Expiry sweeper, inside the server process, runs at startup, every ten minutes and whenever the workspace list is opened",
        "It deletes workspaces past their expiry date (files, guest links and bytes together) and partial uploads idle for a day"
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown here",
      "items": [
        "Deletes a key holder makes by hand (a file or a workspace), which run the same removal immediately from the router",
        "Connected but out of scope: cloudflared tunnel, Access keys, Chunked uploads, Guest links, Zip streamer, Env file"
      ]
    },
    {
      "dot": "violet",
      "title": "Trade-offs",
      "items": [
        "Expiry really deletes: bytes, metadata and guest links go together: keeps the disk bounded with no admin chores, at the cost of no undo; the default is 30 days"
      ]
    }
  ]

  "cards": [
    {
      "dot": "cyan",
      "title": "The short answer",
      "items": [
        "An admin runs add-keys.sh over SSH",
        "it generates a key per name, writes TRANSFER_ACCESS_KEYS into the root-only env file, prints the keys once and restarts the server",
        "The server hands those keys to Access keys, which matches a typed key to a person and signs a session cookie with that person's key, so each key can be rotated alone"
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown here",
      "items": [
        "Visitors' browsers, which only ever see their own key and a signed cookie",
        "Connected but out of scope: cloudflared tunnel, Chunked uploads, Guest links, Zip streamer, SQLite, Expiry sweeper"
      ]
    },
    {
      "dot": "emerald",
      "title": "Doctrine",
      "items": [
        "Access keys exist only in /etc/2dee-transfer.env: the repository is public; add-keys.sh generates keys on the host and prints them once"
      ]
    }
  ]

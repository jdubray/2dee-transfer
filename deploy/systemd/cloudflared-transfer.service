[Unit]
Description=Cloudflare tunnel for transfer.2dee.org
After=network-online.target
Wants=network-online.target 2dee-transfer.service

[Service]
Type=simple
User=cloudflared
Group=cloudflared
Environment=HOME=/var/lib/cloudflared
ExecStart=/usr/local/bin/cloudflared tunnel --config /etc/cloudflared-transfer/config.yml run
Restart=on-failure
RestartSec=2s

ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/cloudflared-transfer
ReadWritePaths=/var/lib/cloudflared

[Install]
WantedBy=multi-user.target

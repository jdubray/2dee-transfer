# /etc/2dee-transfer.env  (chmod 640, owner root:transfer)

# The code your friends type to get in. Changing it signs everyone out.
TRANSFER_ACCESS_CODE=change-me-to-something-long

TRANSFER_PUBLIC_ORIGIN=https://transfer.2dee.org
TRANSFER_HOST=127.0.0.1
TRANSFER_PORT=4180
TRANSFER_DATA_DIR=/var/lib/2dee-transfer

# Optional. If unset, a secret is generated once into $TRANSFER_DATA_DIR/session.secret.
# TRANSFER_SESSION_SECRET=

# Limits (bytes). Defaults: 100 MiB per file, 50 GiB total, 8 MiB upload chunks.
# Keep the chunk size well under Cloudflare's 100 MB request-body cap.
# TRANSFER_MAX_FILE_BYTES=104857600
# TRANSFER_MAX_TOTAL_BYTES=53687091200
# TRANSFER_CHUNK_BYTES=8388608
